# ============================================
# Template file .env
# Copia questo file e rinominalo in .env
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mongodb://localhost:27017/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# API Keys
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# Telegram Bot (se applicabile)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Node Environment
NODE_ENV=production
PORT=3000

# Redis (se applicabile)
# REDIS_URL=redis://localhost:6379

# JWT
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=7d

# OpenAI (se applicabile)
# OPENAI_API_KEY=sk-...

# Stripe (se applicabile)
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email (se applicabile)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_password

# Altri secrets specifici del progetto
# Aggiungi qui le tue variabili d'ambiente
